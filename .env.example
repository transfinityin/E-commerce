# Transfinity local Docker overrides (safe defaults)
# Copy values into Render / Vercel dashboards for production.

DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# Local Docker Postgres (compose also injects this)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ecommerce_db

# Production: paste Neon pooled connection string here / in Render
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Keep existing Cloudinary / Razorpay / Google / Email secrets from your .env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
